{
  "schema": "lattice.plugin.manifest.v2",
  "id": "latticenet.wireguard",
  "name": "WireGuard (VPN networks)",
  "type": "system",
  "capabilities": [
    "node:read",
    "network:plan",
    "network:apply",
    "task:run"
  ],
  "version": "0.2.0-alpha.7",
  "publisher": "latticenet",
  "signature_ed25519": "hE/Y9u0/sq2LbV4qs6TRuN88RR6ajr9tEhVCbmE1ib/3dJs82Ix70iiESRIEq1nd+6POe2nchf69nexVL3puAQ==",
  "bundle": {
    "format": "tar+gzip",
    "digest_sha256": "e7fa2eb1f1a3d1ec4d81b6ca2f3360cc1ad5dbca577b3da45621e50ea4b934f9"
  },
  "runtime": {
    "protocol": "stdio-json-v1",
    "entrypoints": {
      "linux/amd64": "bin/linux-amd64/plugin",
      "linux/arm64": "bin/linux-arm64/plugin"
    }
  },
  "ui_runtime": {
    "mode": "sandbox",
    "entrypoint": "ui/index.html",
    "bridge_version": "1"
  },
  "compatibility": {
    "server": "\u003e=0.2.1",
    "dashboard_host": "\u003e=1",
    "runtime_protocol": "\u003e=1"
  },
  "ui": {
    "nav": [
      {
        "section": "extensions",
        "section_title": "Extensions",
        "title": "WireGuard mesh",
        "route": "networks",
        "icon": "Spline",
        "scopes": [
          "wireguard:read"
        ]
      }
    ],
    "views": [
      {
        "route": "networks",
        "title": "WireGuard mesh",
        "kind": "sandbox"
      }
    ]
  },
  "interfaces": [
    {
      "service": "latticenet.wireguard/networks",
      "methods": [
        {
          "name": "overview",
          "effect": "read",
          "scopes": [
            "wireguard:read"
          ]
        },
        {
          "name": "plan",
          "effect": "plan",
          "scopes": [
            "wireguard:admin",
            "network:plan"
          ]
        }
      ],
      "backing": "core"
    }
  ]
}
