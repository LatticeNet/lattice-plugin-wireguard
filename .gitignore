system-go/lattice-plugin-wireguard
ui/node_modules/
ui/dist/
dist/
.DS_Store

# Publisher signing material. `pluginsign` reads a raw 32-byte Ed25519 seed from a
# file path, so a stray `seed.bin` in the working tree is one `git add -A` away from
# being published. Never commit key material; keep seeds outside the repo.
*.key
*.pem
*.seed
seed
seed.*
*_seed
*.bin

# The compiled system-go binary was committed by accident. It is a host
# artifact, never part of the signed bundle (which carries bin/<os>-<arch>/plugin
# built in CI), so tracking it only produced a 3 MB diff whenever anyone built.
/system-go/system-go
